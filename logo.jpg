/* ============================
   Tokens
   ============================ */
:root {
  --ink: #12151a;
  --panel: #181d26;
  --panel-line: #262e3c;
  --navy: #1e2a44;
  --blue: #3b7dff;
  --blue-dim: #2a4e8c;
  --amber: #f0a03c;
  --amber-bright: #ffc670;
  --fen-grey: #99a4b3;
  --paper: #edeff2;

  --font-display: "Space Grotesk", sans-serif;
  --font-body: "Inter", sans-serif;
  --font-mono: "IBM Plex Mono", monospace;

  --edge: 24px;
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  * { animation: none !important; transition: none !important; }
}

body {
  margin: 0;
  background: var(--ink);
  color: var(--paper);
  font-family: var(--font-body);
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

img { max-width: 100%; display: block; }

a { color: inherit; text-decoration: none; }

.eyebrow {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--amber);
  margin: 0 0 14px;
}

.section-title {
  font-family: var(--font-display);
  font-weight: 600;
  font-size: clamp(1.8rem, 3.4vw, 2.6rem);
  letter-spacing: -0.01em;
  margin: 0 0 20px;
  color: var(--paper);
}

/* ============================
   Signature element: the current line
   A glowing conduit that runs the height of the page,
   filling as you scroll — echoing the LED channel lighting in the work photos.
   ============================ */
.current-line {
  position: fixed;
  top: 0;
  left: 10px;
  width: 2px;
  height: 100%;
  background: rgba(240, 160, 60, 0.12);
  z-index: 40;
}

.current-line__fill {
  width: 100%;
  height: 0%;
  background: linear-gradient(180deg, var(--amber-bright), var(--amber) 60%, var(--blue));
  box-shadow: 0 0 10px 1px rgba(240, 160, 60, 0.55);
  transition: height 0.15s linear;
}

@media (max-width: 720px) {
  .current-line { display: none; }
}

.hero__node {
  position: absolute;
  left: 10px;
  top: 0;
  width: 10px;
  height: 10px;
  transform: translateX(-4px);
  border-radius: 50%;
  background: var(--panel-line);
  box-shadow: 0 0 0 3px var(--ink);
  transition: background 0.4s ease, box-shadow 0.4s ease;
}

.hero__node.lit {
  background: var(--amber-bright);
  box-shadow: 0 0 12px 3px rgba(255, 198, 112, 0.7), 0 0 0 3px var(--ink);
}

@media (max-width: 720px) {
  .hero__node { display: none; }
}

/* ============================
   Nav
   ============================ */
.nav {
  position: sticky;
  top: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 14px var(--edge);
  background: rgba(18, 21, 26, 0.86);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--panel-line);
}

.nav__brand {
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: var(--font-display);
  font-weight: 700;
  letter-spacing: 0.02em;
}

.nav__logo {
  width: 34px;
  height: 34px;
  object-fit: cover;
  border-radius: 6px;
}

.nav__links {
  display: flex;
  gap: 28px;
  font-size: 0.92rem;
  color: var(--fen-grey);
}

.nav__links a:hover { color: var(--paper); }

.nav__call {
  font-family: var(--font-mono);
  font-size: 0.85rem;
  border: 1px solid var(--blue);
  color: var(--paper);
  padding: 8px 16px;
  border-radius: 999px;
  white-space: nowrap;
}

.nav__call:hover { background: var(--blue); }

.nav__toggle {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 6px;
}

.nav__toggle span {
  width: 22px;
  height: 2px;
  background: var(--paper);
}

@media (max-width: 780px) {
  .nav__links {
    position: fixed;
    top: 62px;
    left: 0;
    right: 0;
    background: var(--ink);
    border-bottom: 1px solid var(--panel-line);
    flex-direction: column;
    padding: 20px var(--edge) 24px;
    gap: 16px;
    transform: translateY(-130%);
    transition: transform 0.3s ease;
  }
  .nav__links.open { transform: translateY(0); }
  .nav__toggle { display: flex; }
  .nav__call { display: none; }
}

/* ============================
   Layout helpers
   ============================ */
[data-section] {
  position: relative;
  padding: 100px var(--edge);
}

.section-inner, .hero__inner {
  max-width: 1080px;
  margin: 0 auto;
}

/* ============================
   Hero
   ============================ */
.hero {
  padding-top: 140px;
  padding-bottom: 120px;
  background:
    radial-gradient(1100px 500px at 85% -10%, rgba(59, 125, 255, 0.16), transparent 60%),
    radial-gradient(800px 400px at 10% 110%, rgba(240, 160, 60, 0.1), transparent 60%);
}

.hero__title {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: clamp(2.6rem, 7vw, 5.2rem);
  line-height: 1.02;
  letter-spacing: -0.02em;
  margin: 0 0 26px;
}

.hero__lead {
  max-width: 540px;
  font-size: 1.08rem;
  color: var(--fen-grey);
  margin: 0 0 40px;
}

.hero__actions { display: flex; gap: 16px; flex-wrap: wrap; }

.btn {
  font-family: var(--font-mono);
  font-size: 0.9rem;
  padding: 14px 26px;
  border-radius: 999px;
  border: 1px solid transparent;
}

.btn--primary {
  background: var(--amber);
  color: #17130a;
  font-weight: 600;
}
.btn--primary:hover { background: var(--amber-bright); }

.btn--ghost {
  border-color: var(--panel-line);
  color: var(--paper);
}
.btn--ghost:hover { border-color: var(--blue); }

/* ============================
   Services
   ============================ */
.services { background: var(--panel); }

.services__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: var(--panel-line);
  border: 1px solid var(--panel-line);
  margin-top: 40px;
}

.service-card {
  background: var(--panel);
  padding: 30px 26px;
}

.service-card__mark {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: 0.75rem;
  letter-spacing: 0.1em;
  color: var(--amber);
  border: 1px solid var(--blue-dim);
  padding: 3px 9px;
  border-radius: 999px;
  margin-bottom: 16px;
}

.service-card h3 {
  font-family: var(--font-display);
  font-size: 1.05rem;
  font-weight: 600;
  margin: 0 0 10px;
}

.service-card p {
  color: var(--fen-grey);
  font-size: 0.92rem;
  margin: 0;
}

@media (max-width: 900px) {
  .services__grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 600px) {
  .services__grid { grid-template-columns: 1fr; }
}

/* ============================
   Work / gallery
   ============================ */
.gallery {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18px;
  margin-top: 40px;
}

.gallery__item {
  margin: 0;
  border: 1px solid var(--panel-line);
  border-radius: 10px;
  overflow: hidden;
  background: var(--panel);
}

.gallery__item--wide { grid-column: span 2; }

.gallery__item img {
  width: 100%;
  height: 340px;
  object-fit: cover;
}

.gallery__item--wide img { height: 380px; }

.gallery__item figcaption {
  padding: 14px 18px;
  font-size: 0.86rem;
  color: var(--fen-grey);
  border-top: 1px solid var(--panel-line);
}

@media (max-width: 780px) {
  .gallery { grid-template-columns: 1fr; }
  .gallery__item--wide { grid-column: span 1; }
  .gallery__item img, .gallery__item--wide img { height: 260px; }
}

/* ============================
   About
   ============================ */
.about { background: var(--ink); }

.about__inner {
  display: grid;
  grid-template-columns: 1.3fr 1fr;
  gap: 60px;
  align-items: start;
}

.about__text p {
  color: var(--fen-grey);
  font-size: 1rem;
  max-width: 520px;
}

.about__stats {
  display: grid;
  gap: 24px;
  border-left: 1px solid var(--panel-line);
  padding-left: 32px;
}

.stat__num {
  display: block;
  font-family: var(--font-display);
  font-size: 2.2rem;
  font-weight: 700;
  color: var(--amber-bright);
}

.stat__label {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  color: var(--fen-grey);
  letter-spacing: 0.02em;
}

@media (max-width: 780px) {
  .about__inner { grid-template-columns: 1fr; gap: 36px; }
  .about__stats { border-left: none; padding-left: 0; grid-template-columns: repeat(3, 1fr); }
}

/* ============================
   Contact
   ============================ */
.contact {
  background: var(--panel);
  border-top: 1px solid var(--panel-line);
}

.contact__lead {
  color: var(--fen-grey);
  max-width: 480px;
  margin: 0 0 40px;
}

.contact__cards {
  display: flex;
  gap: 18px;
  flex-wrap: wrap;
}

.contact-card {
  flex: 1 1 260px;
  background: var(--ink);
  border: 1px solid var(--panel-line);
  border-radius: 10px;
  padding: 24px 26px;
}

.contact-card:hover { border-color: var(--amber); }

.contact-card__label {
  display: block;
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--fen-grey);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 10px;
}

.contact-card__value {
  display: block;
  font-family: var(--font-display);
  font-weight: 600;
  font-size: 1.2rem;
}

/* ============================
   Footer
   ============================ */
.footer {
  text-align: center;
  padding: 50px var(--edge) 60px;
  color: var(--fen-grey);
  font-size: 0.85rem;
  border-top: 1px solid var(--panel-line);
}

.footer__logo {
  width: 40px;
  height: 40px;
  object-fit: cover;
  border-radius: 8px;
  margin: 0 auto 16px;
}

.footer__meta { margin-top: 6px; font-family: var(--font-mono); font-size: 0.78rem; }

/* Keyboard focus visibility */
a:focus-visible, button:focus-visible {
  outline: 2px solid var(--amber-bright);
  outline-offset: 2px;
}
